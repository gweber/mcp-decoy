{
  "name": "mcp-decoy",
  "version": "1.2.0",
  "description": "MCP server decoy for deception-based threat detection",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "decoy",
    "deception",
    "security",
    "honeypot",
    "siem"
  ],
  "author": "Taro Weber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gweber/mcp-decoy.git"
  },
  "bugs": {
    "url": "https://github.com/gweber/mcp-decoy/issues"
  },
  "homepage": "https://github.com/gweber/mcp-decoy#readme",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
